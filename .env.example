# Database (Neon Postgres, or any Postgres connection string)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js
AUTH_SECRET="" # generate with: npx auth secret
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"

# Token encryption (32-byte key, base64) for encrypting stored OAuth tokens at rest
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Groq (CopilotKit LLM adapter)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b" # any currently-supported tool-calling model, see console.groq.com/docs/models

# Google Cloud Pub/Sub (real-time Gmail push) — not yet wired up, reserved for future use
GOOGLE_CLOUD_PROJECT_ID=""
GMAIL_PUBSUB_TOPIC=""
GMAIL_PUBSUB_VERIFICATION_TOKEN=""
